# ===========================================================================
# LS·Aegis 雷铄 OA 安全应用构建平台生产环境变量模板
# 用法：复制为仓库根目录 .env，或由 scripts/init-env.sh / install.sh 自动生成
# 禁止把真实密钥提交到 Git（*.env 已 gitignore）
# ===========================================================================

# 产品镜像版本，与根目录 VERSION 一致；不修改 MySQL/Redis 等第三方版本
ITLS_VERSION=1.2.0

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
DB_USER=ls_aegis_app
DB_PWD=CHANGE_ME_MYSQL_APP

# ---------- Redis ----------
REDIS_PWD=CHANGE_ME_REDIS

# ---------- 应用安全 ----------
JWT_SECRET_KEY=CHANGE_ME_JWT_32CHARS_MIN_______
TOKEN_SECRET=CHANGE_ME_TOKEN_SECRET_32CHARS_MIN_
ENCRYPT_AES_PASSWORD=CHANGE_ME_AES_PASSWORD_32CHARS_MIN
# 可选 RSA（签章存量兼容；空则仅用 TOKEN_SECRET / 国密）
ENCRYPT_RSA_PUBLIC_KEY=
ENCRYPT_RSA_PRIVATE_KEY=

# ---------- 国密 ----------
GM_KEY_STORE_PATH=/app/data/gm/keys.properties
FILE_DIGEST_MIGRATE_TO_SM3=false

# ---------- 多租户 / 调度（生产默认关）----------
CONTINEW_STARTER_TENANT_ENABLED=false
SNAIL_JOB_ENABLED=false
SNAIL_JOB_URL=http://127.0.0.1:8001/snail-job
SCHEDULE_TOKEN=
SCHEDULE_USERNAME=schedule
SCHEDULE_PASSWORD=

# ---------- 对外访问（install.sh / 宝塔反代后填写；三域名）----------
# PC 后台
APPLICATION_URL=https://oa.example.com
ITLS_PUBLIC_DOMAIN=oa.example.com
ITLS_PUBLIC_BASE_URL=https://oa.example.com
# H5 客户 / 工程师
ITLS_H5_CUSTOMER_DOMAIN=kh.example.com
ITLS_H5_ENGINEER_DOMAIN=gc.example.com
ITLS_H5_CUSTOMER_URL=https://kh.example.com
ITLS_H5_ENGINEER_URL=https://gc.example.com
ITLS_CORS_ALLOWED_ORIGINS=https://oa.example.com,https://kh.example.com,https://gc.example.com

# Docker 生产：挂载 init.sql 初始化时关闭 Liquibase（避免种子重复插入）
SPRING_LIQUIBASE_ENABLED=false
MYSQL_USE_SSL=false

# Optional paths for docker-compose.local.yml; existing deployments can retain external persistent directories.
LS_AEGIS_DATA_DIR=./docker/data/ls-aegis-server/data
LS_AEGIS_LOG_DIR=./docker/data/ls-aegis-server/logs
