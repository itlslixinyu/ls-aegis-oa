# 复制为 docker/.env（也可直接跑 ensure-env.ps1 / dev-up.ps1：缺文件则从本模板创建）
# 空的必填密钥会由 ensure-env.ps1 随机生成并写回（已有值不覆盖；docker/.env 已 gitignore）
# 一键开发：仓库根目录 CMD 执行  dev.cmd  （或 d:\itls\docker\dev-all.cmd）
# 仅中间件：powershell -File docker/dev-up.ps1
# 本机后端会读本文件；dev-run-server.ps1 会把 GM 路径改写为宿主机 data 目录
MYSQL_ROOT_PASSWORD=
DB_PWD=
REDIS_PWD=
JWT_SECRET_KEY=
# 签章敏感字段加解密（≥32 字符；空则 ensure-env 自动生成写回）
TOKEN_SECRET=
ENCRYPT_AES_PASSWORD=
ENCRYPT_RSA_PUBLIC_KEY=
ENCRYPT_RSA_PRIVATE_KEY=
# 国密密钥文件（Docker 容器内路径；本机跑后端时由 dev-run-server.ps1 改写）
GM_KEY_STORE_PATH=/app/data/gm/keys.properties
# 存量文件指纹 SHA256→SM3：运维窗口设为 true 重启一次，完成后改回 false（也可调 POST /system/file/migrate-digest-sm3）
FILE_DIGEST_MIGRATE_TO_SM3=false
# 多租户中间件（默认关；true 后还须在「功能模块」打开租户管理）
CONTINEW_STARTER_TENANT_ENABLED=false
SNAIL_JOB_ENABLED=false
SNAIL_JOB_URL=http://127.0.0.1:8001/snail-job
SCHEDULE_TOKEN=
SCHEDULE_USERNAME=schedule
SCHEDULE_PASSWORD=
# 完整 Docker 栈用 8080；本机 Vite 开发由 dev-run-server.ps1 覆盖为 http://localhost:5173
APPLICATION_URL=http://localhost:8080
