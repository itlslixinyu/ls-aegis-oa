# LS・Aegis Server 生产镜像：多阶段 Maven 构建 → Eclipse Temurin JRE 21
# 构建上下文：仓库根目录
#   docker build -f docker/ls-aegis-server/Dockerfile.prod -t ls-aegis-server:1.0.0 .

# ---------- 阶段 1：Maven 打包 ----------
FROM maven:3.9-eclipse-temurin-21 AS builder

WORKDIR /build

# 国内 Maven 中央库镜像（阿里云），避免外网拉依赖失败
RUN mkdir -p /root/.m2 \
 && printf '%s\n' \
  '<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"' \
  '  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"' \
  '  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">' \
  '  <mirrors>' \
  '    <mirror>' \
  '      <id>aliyun-central</id>' \
  '      <mirrorOf>*</mirrorOf>' \
  '      <name>Aliyun Maven</name>' \
  '      <url>https://maven.aliyun.com/repository/central</url>' \
  '    </mirror>' \
  '  </mirrors>' \
  '</settings>' > /root/.m2/settings.xml

COPY ls-aegis-server/ /build/ls-aegis-server/

WORKDIR /build/ls-aegis-server
RUN mvn -B -DskipTests package \
 && JAR=$(find ls-aegis-boot/target -maxdepth 1 -name 'ls-aegis-server*.jar' ! -name '*.original' | head -1) \
 && test -n "$JAR" \
 && cp "$JAR" /build/app.jar

# ---------- 阶段 2：运行 ----------
FROM eclipse-temurin:21-jre

LABEL maintainer="LS Aegis" \
      description="LS Aegis Server (production)"

ENV TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200" \
    SPRING_PROFILES_ACTIVE=prod \
    SERVER_PORT=18000

WORKDIR /app

# 固定 UID，便于宿主机 chown 对齐
RUN mkdir -p /app/data /app/logs /app/config /app/fonts \
 && groupadd -r -g 10001 aegis \
 && useradd -r -u 10001 -g aegis -d /app -s /sbin/nologin aegis \
 && chown -R aegis:aegis /app

# 水印 / AWT 中文：文泉驿（国内 apt 易得）；另 COPY 可选 TrueType（simhei）供 PDF
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      fontconfig fonts-wqy-microhei util-linux \
 && fc-cache -fv \
 && rm -rf /var/lib/apt/lists/*

COPY docker/ls-aegis-server/fonts/ /usr/share/fonts/truetype/aegis/
RUN fc-cache -fv || true

COPY --from=builder --chown=aegis:aegis /build/app.jar /app/app.jar
COPY docker/ls-aegis-server/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod 755 /docker-entrypoint.sh \
 && sed -i 's/\r$//' /docker-entrypoint.sh

EXPOSE 18000

# 启动期较长；探测 TCP 18000
HEALTHCHECK --interval=20s --timeout=5s --start-period=300s --retries=15 \
  CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/18000' || exit 1

# 以 root 进入口脚本（修正挂载权限后降权为 aegis）
USER root
ENTRYPOINT ["/docker-entrypoint.sh"]
