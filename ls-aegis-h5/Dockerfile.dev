# 开发环境 Dockerfile - H5 移动端
# 使用 Vite dev server 实现 HMR
FROM node:20-alpine

ENV TZ=Asia/Shanghai

WORKDIR /app

# 预装依赖
COPY package.json package-lock.json ./
RUN npm ci --registry=https://registry.npmmirror.com

EXPOSE 80

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "80"]
