# 环境变量 (命名必须以 VITE_ 开头)
# 日常开发：npm run dev → Vite(5173)；接口经 /api 代理到本机后端 8000
# 中间件：powershell -File docker/dev-up.ps1（仅 MySQL/Redis）
# 后端：powershell -File docker/dev-run-server.ps1（或 IDE 跑 ls-aegis-boot，profile=dev）
# H5：客户 5174，工程师 5175
# 不要访问 nginx 8080（那是部署态 dist，无 HMR）；完整 Docker 栈后端才是 18000

# 接口前缀（与生产一致，由 Vite 代理剥离后转发）
VITE_API_PREFIX=/api

# 本机后端（application-dev.yml 默认 port=8000）
VITE_API_BASE_URL=http://127.0.0.1:8000

# WebSocket
VITE_API_WS_URL=ws://127.0.0.1:8000

# 地址前缀
VITE_BASE=/

# 是否开启开发者工具
VITE_OPEN_DEVTOOLS=false

# 本地 mock（默认关闭；需要时改为 true）
VITE_LOCAL_MOCK=false

# 应用配置面板
VITE_APP_SETTING=true

# 运营中枢顶栏天气城市（可改）
VITE_DASHBOARD_WEATHER_CITY=北京

# 客户端ID
VITE_CLIENT_ID=ef51c9a3e9046c4f2ea45142c8a8344a
