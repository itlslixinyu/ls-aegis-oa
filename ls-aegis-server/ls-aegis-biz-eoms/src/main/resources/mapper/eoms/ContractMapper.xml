<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ls.aegis.biz.eoms.mapper.contract.ContractMapper">
    
    <resultMap type="Contract" id="ContractResult">
    	<id     property="id"      column="id"      />
        <result property="contractNo"    column="contract_no"    />
        <result property="customerId"    column="customer_id"    />
        <result property="projectId"     column="project_id"     />
        <result property="customerNo"    column="customer_no"    />
        <result property="customerName"    column="customer_name"    />
        <result property="contractName"    column="contract_name"    />
        <result property="contractType"    column="contract_type"    />
        <result property="amount"    column="amount"    />
        <result property="signDate"    column="sign_date"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"    column="end_date"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createUser"  column="create_user"  />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="fileId"    column="file_id"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="tenantId"  column="tenant_id"    />
        <result property="deptId"    column="dept_id"      />
    </resultMap>

    <sql id="selectContractVo">
        select ct.id, ct.contract_no, ct.customer_id, ct.project_id, ct.contract_name, ct.contract_type, ct.amount,
               ct.sign_date, ct.start_date, ct.end_date, ct.status, ct.create_by, ct.create_user, ct.create_time, ct.update_by, ct.update_time, ct.remark, ct.file_id, ct.del_flag,
               ct.tenant_id, ct.dept_id,
               c.unit_code as customer_no,
               c.unit_name as customer_name
		from eoms_contract ct
		left join psi_unit c on ct.customer_id = c.id and c.deleted = 0
    </sql>

    <select id="selectContractById" parameterType="Long" resultMap="ContractResult">
        <include refid="selectContractVo"/>
        where ct.id = #{id} and ct.del_flag = '0'
    </select>

    <select id="selectContractList" parameterType="Contract" resultMap="ContractResult">
        <include refid="selectContractVo"/>
        <where>
			ct.del_flag = '0'
			<if test="id != null">
				AND ct.id = #{id}
			</if>
			<if test="contractNo != null and contractNo != ''">
				AND ct.contract_no = #{contractNo}
			</if>
			<if test="customerId != null">
				AND ct.customer_id = #{customerId}
			</if>
			<if test="projectId != null">
				AND ct.project_id = #{projectId}
			</if>
			<if test="unboundOnly != null and unboundOnly">
				AND ct.project_id IS NULL
			</if>
			<if test="customerName != null and customerName != ''">
				AND c.unit_name like concat('%', #{customerName}, '%')
			</if>
			<if test="contractName != null and contractName != ''">
				AND ct.contract_name like concat('%', #{contractName}, '%')
			</if>
			<if test="contractType != null and contractType != ''">
				AND ct.contract_type = #{contractType}
			</if>
			<if test="status != null and status != ''">
				AND ct.status = #{status}
			</if>
			<if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
				and ct.create_time &gt;= #{params.beginTime}
			</if>
			<if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
				and ct.create_time &lt; DATE_ADD(DATE(#{params.endTime}), INTERVAL 1 DAY)
			</if>
			<include refid="com.ls.aegis.biz.eoms.mapper.EomsDataScopeMapper.dataScopeFilter"/>
		</where>
    </select>

    <insert id="insertContract" parameterType="Contract" useGeneratedKeys="true" keyProperty="id">
        insert into eoms_contract
        <trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="contractNo != null and contractNo != ''">contract_no,</if>
			<if test="customerId != null">customer_id,</if>
			<if test="projectId != null">project_id,</if>
			<if test="contractName != null and contractName != ''">contract_name,</if>
			<if test="contractType != null and contractType != ''">contract_type,</if>
			<if test="amount != null">amount,</if>
			<if test="signDate != null">sign_date,</if>
			<if test="startDate != null">start_date,</if>
			<if test="endDate != null">end_date,</if>
			<if test="status != null and status != ''">status,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			<if test="createUser != null">create_user,</if>
			<if test="true">create_time,</if>
			<if test="updateBy != null and updateBy != ''">update_by,</if>
			<if test="updateTime != null and updateTime != ''">update_time,</if>
			<if test="remark != null and remark != ''">remark,</if>
			<if test="fileId != null">file_id,</if>
			<if test="delFlag != null and delFlag != ''">del_flag,</if>
			<if test="tenantId != null">tenant_id,</if>
			<if test="deptId != null">dept_id,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="contractNo != null and contractNo != ''">#{contractNo},</if>
			<if test="customerId != null">#{customerId},</if>
			<if test="projectId != null">#{projectId},</if>
			<if test="contractName != null and contractName != ''">#{contractName},</if>
			<if test="contractType != null and contractType != ''">#{contractType},</if>
			<if test="amount != null">#{amount},</if>
			<if test="signDate != null">#{signDate},</if>
			<if test="startDate != null">#{startDate},</if>
			<if test="endDate != null">#{endDate},</if>
			<if test="status != null and status != ''">#{status},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			<if test="createUser != null">#{createUser},</if>
			<if test="true">sysdate(),</if>
			<if test="updateBy != null and updateBy != ''">#{updateBy},</if>
			<if test="updateTime != null and updateTime != ''">#{updateTime},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
			<if test="fileId != null">#{fileId},</if>
			<if test="delFlag != null and delFlag != ''">#{delFlag,jdbcType=CHAR},</if>
			<if test="tenantId != null">#{tenantId},</if>
			<if test="deptId != null">#{deptId},</if>
        </trim>
    </insert>

    <update id="updateContract" parameterType="Contract">
        update eoms_contract 
        <set>
            <if test="contractNo != null and contractNo != ''">contract_no = #{contractNo},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="contractName != null and contractName != ''">contract_name = #{contractName},</if>
            <if test="contractType != null and contractType != ''">contract_type = #{contractType},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="signDate != null">sign_date = #{signDate},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate(),
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="fileId != null">file_id = #{fileId},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </set>
        where id = #{id}
    </update>

    <update id="deleteContractById" parameterType="Long">
        update eoms_contract set del_flag = '2' where id = #{id}
    </update>

    <update id="deleteContractByIds" parameterType="Long">
        update eoms_contract set del_flag = '2' where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
        	#{id}
        </foreach>
    </update>

    <update id="bindProject">
        update eoms_contract
        set project_id = #{projectId},
            update_time = sysdate()
        where id = #{id} and del_flag = '0'
    </update>

</mapper>
