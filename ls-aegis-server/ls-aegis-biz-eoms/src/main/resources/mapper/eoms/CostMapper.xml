<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ls.aegis.biz.eoms.mapper.finance.CostMapper">
    
    <resultMap type="Cost" id="CostResult">
    	<id     property="id"      column="id"      />
        <result property="repairOrderId"    column="repair_order_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="costType"    column="cost_type"    />
        <result property="amount"    column="amount"    />
        <result property="description"    column="description"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="settlementId" column="settlement_id"/>
        <result property="reversalOfId" column="reversal_of_id"/>
    </resultMap>

    <sql id="selectCostVo">
        select cs.id, cs.settlement_id, cs.reversal_of_id, cs.repair_order_id, cs.cost_type, cs.amount, cs.description,
               cs.create_by, cs.create_time, cs.update_by, cs.update_time, cs.remark, cs.del_flag,
               o.order_no as order_no
		from eoms_cost cs
		left join eoms_repair_order o on cs.repair_order_id = o.id
    </sql>

    <select id="selectCostById" parameterType="Long" resultMap="CostResult">
        <include refid="selectCostVo"/>
        where cs.id = #{id} and cs.del_flag = '0'
    </select>

    <select id="selectCostList" parameterType="Cost" resultMap="CostResult">
        <include refid="selectCostVo"/>
        <where>
			cs.del_flag = '0'
			<if test="repairOrderId != null">
				AND cs.repair_order_id = #{repairOrderId}
			</if>
			<if test="costType != null and costType != ''">
				AND cs.cost_type = #{costType}
			</if>
			<if test="orderNo != null and orderNo != ''">
				AND o.order_no = #{orderNo}
			</if>
			<if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
				and cs.create_time &gt;= #{params.beginTime}
			</if>
			<if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
				and cs.create_time &lt; DATE_ADD(DATE(#{params.endTime}), INTERVAL 1 DAY)
			</if>
		</where>
    </select>

    <insert id="insertCost" parameterType="Cost" useGeneratedKeys="true" keyProperty="id">
        insert into eoms_cost
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="reversalOfId != null">reversal_of_id,</if>
            <if test="settlementId != null">settlement_id,</if>
			<if test="repairOrderId != null">repair_order_id,</if>
			<if test="costType != null and costType != ''">cost_type,</if>
			<if test="amount != null">amount,</if>
			<if test="description != null and description != ''">description,</if>
			<if test="createBy != null and createBy != ''">create_by,</if>
			<if test="true">create_time,</if>
			<if test="updateBy != null and updateBy != ''">update_by,</if>
			<if test="updateTime != null and updateTime != ''">update_time,</if>
			<if test="remark != null and remark != ''">remark,</if>
			<if test="delFlag != null and delFlag != ''">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="reversalOfId != null">#{reversalOfId},</if>
            <if test="settlementId != null">#{settlementId},</if>
			<if test="repairOrderId != null">#{repairOrderId},</if>
			<if test="costType != null and costType != ''">#{costType},</if>
			<if test="amount != null">#{amount},</if>
			<if test="description != null and description != ''">#{description},</if>
			<if test="createBy != null and createBy != ''">#{createBy},</if>
			<if test="true">sysdate(),</if>
			<if test="updateBy != null and updateBy != ''">#{updateBy},</if>
			<if test="updateTime != null and updateTime != ''">#{updateTime},</if>
			<if test="remark != null and remark != ''">#{remark},</if>
			<if test="delFlag != null and delFlag != ''">#{delFlag,jdbcType=CHAR},</if>
        </trim>
    </insert>

    <update id="updateCost" parameterType="Cost">
        update eoms_cost 
        <set>
            <if test="repairOrderId != null">repair_order_id = #{repairOrderId},</if>
            <if test="costType != null and costType != ''">cost_type = #{costType},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="description != null and description != ''">description = #{description},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate(),
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </set>
        where id = #{id}
    </update>

    <update id="deleteCostById" parameterType="Long">
        update eoms_cost set del_flag = '2' where id = #{id}
    </update>

    <update id="deleteCostByIds" parameterType="Long">
        update eoms_cost set del_flag = '2' where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
        	#{id}
        </foreach>
    </update>

    <select id="lockByOrder" resultMap="CostResult">
        select * from eoms_cost where repair_order_id=#{orderId} and del_flag='0' for update
    </select>
</mapper>
