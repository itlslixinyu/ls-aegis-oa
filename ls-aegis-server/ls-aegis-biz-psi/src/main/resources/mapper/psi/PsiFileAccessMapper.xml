<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ls.aegis.biz.psi.mapper.file.PsiFileAccessMapper">

    <sql id="fileInCsv">
        FIND_IN_SET(#{fileId}, REPLACE(file_id, ' ', '')) &gt; 0
    </sql>

    <select id="countAccessible" resultType="int">
        SELECT COUNT(1) FROM
        <choose>
            <when test="kind == 'contractSale'">psi_contract_sale</when>
            <when test="kind == 'contractPurchase'">psi_contract_purchase</when>
            <when test="kind == 'invoiceIn'">psi_invoice_in</when>
            <when test="kind == 'invoiceOut'">psi_invoice_out</when>
            <when test="kind == 'printTemplate'">psi_print_template</when>
            <otherwise>(SELECT 0 AS tenant_id, 1 AS deleted, NULL AS file_id, 0 AS create_user, 0 AS dept_id)</otherwise>
        </choose> ref
        WHERE ref.deleted = 0 AND ref.tenant_id = #{tenantId}
        <choose>
            <when test="kind == 'contractSale' or kind == 'contractPurchase'">
                AND FIND_IN_SET(#{fileId}, REPLACE(ref.file_id, ' ', '')) &gt; 0
            </when>
            <otherwise>AND ref.file_id = #{fileId}</otherwise>
        </choose>
    </select>
</mapper>
